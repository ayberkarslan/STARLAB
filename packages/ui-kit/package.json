{
  "name": "@stardrop/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "catalog",
    "catalog-dist",
    "starter",
    "scripts",
    "vite.config.ts",
    "tsconfig.build.json",
    "OFL-Michroma.txt",
    "tests"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.jsx",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "development": "./src/icons.ts",
      "import": "./dist/icons.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "description": "Black and white React components for desktop workspaces",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --config catalog/vite.config.ts",
    "build:catalog": "vite build --config catalog/vite.config.ts",
    "prepack": "npm run build && npm run build:catalog",
    "check": "npm run build && node scripts/check.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.5"
  }
}
