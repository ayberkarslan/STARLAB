{
  "name": "starlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "build:kernels": "node scripts/build-kernels.mjs",
    "build:engine": "node scripts/build-native.mjs",
    "test:engine": "python3 -m unittest discover -s engine/tests -v",
    "pretest:engine": "npm run build:engine",
    "check:engine": "tsc -p tsconfig.server.json --noEmit",
    "build:ui": "npm run build --prefix packages/ui-kit",
    "dev:ui": "npm run dev --prefix packages/ui-kit",
    "prebuild": "npm run build:ui",
    "postinstall": "npm run build:ui",
    "calcs": "python3 scripts/update-calcs.py"
  },
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@stardrop/ui": "file:packages/ui-kit",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
